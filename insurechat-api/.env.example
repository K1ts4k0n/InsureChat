# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit .env ขึ้น git)
#   cp .env.example .env

# DB ของแอปเอง (SQL Server) — ตาราง Users/AppSettings/Conversations/Orders (ADR 0016)
# ตัวอย่าง: Server=SERVER\INSTANCE;Database=InsureChat;User Id=xxx;Password=xxx;TrustServerCertificate=True
EF_DB_CONNECTION=

# KPN live package DB (read-only) — ดึงข้อมูลแพคเกจรถ 330k (ADR 0004)
KPN_DB_CONNECTION=

# JWT signing key — ตั้งให้ยาว/สุ่ม (อย่างน้อย 32 ตัวอักษร) สำหรับ production
JWT_KEY=

# LLM ผ่าน OpenRouter — ขอ key ที่ https://openrouter.ai (ADR 0003)
OPENROUTER_API_KEY=

# อีเมลคำสั่งซื้อ (Gmail SMTP) — SMTP_PASSWORD ใช้ App Password ไม่ใช่รหัสผ่านปกติ (ADR 0012/0013)
SMTP_USERNAME=
SMTP_PASSWORD=
ORDER_EMAIL_TO=

# Python motor tool (เว้นว่างได้ ถ้าไม่มี vault tools/ + raw/)
MOTOR_SCRIPT_PATH=
MOTOR_WORKING_DIR=

# โฟลเดอร์ความรู้เพิ่มเติม (เว้นว่าง = ใช้ Knowledge/ ที่ bundle มากับแอป)
KNOWLEDGE_DIR=
